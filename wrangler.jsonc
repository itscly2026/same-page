{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "same-page",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
