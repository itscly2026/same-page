{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "same-page",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "samepage.clyapps.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "same-page-production",
      "database_id": "e4af1bb2-5935-413e-bd38-273bb64d1d1e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCORES_BUCKET",
      "bucket_name": "same-page-production-scores"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://samepage.clyapps.com",
    "AUTH_EMAIL_FROM": "Same Page <login@samepage.clyapps.com>"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
