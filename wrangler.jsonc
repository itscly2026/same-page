{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "same-page",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "samepage.clyapps.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "same-page-production",
      "database_id": "e4af1bb2-5935-413e-bd38-273bb64d1d1e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCORES_BUCKET",
      "bucket_name": "same-page-production-scores"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://samepage.clyapps.com",
    "AUTH_EMAIL_FROM": "Same Page <login@samepage.clyapps.com>"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  },
  "containers": [
    {
      "class_name": "PdfRenderer",
      "image": "./renderer/Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PDF_RENDERER",
        "class_name": "PdfRenderer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pdf-renderer-v1",
      "new_sqlite_classes": [
        "PdfRenderer"
      ]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "IMAGE_JOBS",
        "queue": "same-page-images"
      }
    ],
    "consumers": [
      {
        "queue": "same-page-images",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_retries": 2
      }
    ]
  }
}
