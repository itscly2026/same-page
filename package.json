{
  "name": "same-page",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-precache.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test:unit && npm run test:client",
    "test:unit": "vitest run --config vitest.node.config.ts",
    "test:client": "vitest run --config vitest.client.config.ts",
    "test:watch": "vitest --config vitest.client.config.ts",
    "test:worker": "npm run test:worker:unit && npm run test:worker:integration",
    "test:worker:unit": "vitest run --config vitest.worker-unit.config.ts",
    "test:worker:integration": "vitest run --config vitest.worker.config.ts",
    "test:visual-report": "node scripts/run-browser-tests.mjs visual",
    "test:pwa-update": "node scripts/verify-pwa-update.mjs",
    "test:loading-performance": "npm run build && node scripts/measure-loading-performance.mjs",
    "measure:production-loading": "node scripts/measure-production-loading.mjs",
    "prepare:production-pwa": "node scripts/prepare-production-pwa-profile.mjs",
    "test:migrations": "node scripts/verify-score-schema-migration.mjs",
    "test:ci": "node --test scripts/ci-scope.test.mjs",
    "check": "npm run test:ci && npm run lint && npm run typecheck && npm run test && npm run test:worker && npm run test:visual-report && npm run test:migrations && npm run build && npm run test:smoke",
    "check:full": "npm run test:pwa-update && npm run check && node scripts/measure-loading-performance.mjs",
    "visual:report": "npm run build && node scripts/generate-visual-report.mjs",
    "auth:schema": "auth generate --config scripts/better-auth-schema.ts --adapter drizzle --dialect sqlite --output worker/db/auth-schema.generated.ts --yes",
    "db:migrate:local": "node scripts/prepare-drive-owners.mjs --local && wrangler d1 migrations apply same-page-production --local && node scripts/backfill-score-file-names.mjs --local",
    "provision:choir": "node scripts/provision-choir.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "cf-typegen": "wrangler types",
    "deploy": "node scripts/release-artifact.mjs verify \"$SAME_PAGE_RELEASE_SHA\" && wrangler deploy --config dist/same_page/wrangler.json",
    "test:smoke": "node scripts/run-browser-tests.mjs smoke",
    "diagnostics:inbox": "node scripts/diagnostic-reports.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "^1.7.2",
    "d3-polygon": "^3.0.1",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.41.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "perfect-freehand": "^1.2.3",
    "polygon-clipping": "^0.15.7",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "resend": "^6.26.0",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/vitest-plugin": "^1.1.4",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-polygon": "^3.0.2",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "auth": "^1.7.2",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "nanostores": "1.5.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "license": "AGPL-3.0-only"
}
